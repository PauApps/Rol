# Base de dades
# Desenvolupament local (PGlite embegut sense servidor extern):
DATABASE_URL=pglite://./data/rol-dev

# Producció (PostgreSQL estàndard):
# DATABASE_URL=postgresql://usuari:contrasenya@host:5432/rol

# URL base pública de l'aplicació (usada per generar enllaços d'invitació)
APP_BASE_URL=http://localhost:3000

# Administrador principal inicial (es crea si no existeix cap admin)
ROL_ADMIN_EMAIL=admin@rol.local
ROL_ADMIN_PASSWORD=CanviaAquestaContrasenya123!
ROL_ADMIN_NAME=Administrador Principal

# Directori local per emmagatzematge privat de documents (fora de public/)
ROL_STORAGE_DIR=./data/uploads
