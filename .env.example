# ==============================================================================
# Rol — Plantilla de variables d'entorn
# No incloguis mai secrets reals en aquest fitxer. Copia'l a `.env.local` per a local.
# ==============================================================================

# 1. Base de dades (OBLIGATÒRIA a Vercel: Production i Preview)
# - Producció / Preview (Neon PostgreSQL):
#   DATABASE_URL=postgresql://<usuari>:<contrasenya>@<endpoint>-pooler.neon.tech/<bd>?sslmode=require
# - Connexió directa opcional per a migracions en temps de build (si DATABASE_URL usa -pooler):
#   DATABASE_URL_UNPOOLED=postgresql://<usuari>:<contrasenya>@<endpoint>.neon.tech/<bd>?sslmode=require
# - Desenvolupament local (PGlite embegut; només quan NODE_ENV != production):
DATABASE_URL=pglite://./data/rol-dev

# 2. Administrador principal inicial (OBLIGATÒRIES en producció fins crear el primer admin)
# En producció (NODE_ENV=production), si encara no existeix cap compte 'admin' a la BD,
# l'aplicació exigeix ROL_ADMIN_EMAIL i ROL_ADMIN_PASSWORD per crear-lo.
ROL_ADMIN_EMAIL=admin@rol.local
# Defineix una contrasenya robusta (no la desis mai al repositori):
ROL_ADMIN_PASSWORD=
ROL_ADMIN_NAME=Administrador Principal

# 3. URL pública base (RECOMANADA a Production; usada per construir enllaços d'invitació)
# Si s'omet, l'API usa l'origen HTTP de la petició (request.nextUrl.origin).
# A Production posa-hi la URL definitiva (ex. https://rol.el-teu-domini.cat):
APP_BASE_URL=http://localhost:3000

# 4. Emmagatzematge local privat de documents (OPCIONAL; només entorns amb disc persistent)
# A Vercel Serverless el disc no és persistent; preparat per a Storage extern a la Fase 4.
# ROL_STORAGE_DIR=./data/uploads
